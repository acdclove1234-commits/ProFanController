<!-- ==================================================
     PawnIoInstallPanel.xaml - PawnIO（ファン制御用のドライバー）の状態と、アプリの中からのインストール
     (セットアップウィザードと、設定の「安全・バックアップ」で共通に使う)
     Dependencies: WPF / .NET 8 (MIT License)
     See CREDITS.txt for full license details.
     ================================================== -->
<UserControl x:Class="ProFanController.UI.PawnIoInstallPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="StatusLine" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Explanation" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                   Text="ファンの回転数を変えるには、マザーボードのファン制御チップを読み書きするドライバー PawnIO（無料・LibreHardwareMonitor などでも使われています）が必要です。&#10;「PawnIO をインストール」を押すと、Windows に付属の winget で公式のパッケージ（namazso.PawnIO）を入れます。インターネットにつながっている必要があり、数十秒〜数分かかります。終わったら、アプリを起動し直すと使えるようになります。"/>
        <WrapPanel x:Name="ButtonRow" Margin="0,12,0,0">
            <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Content="PawnIO をインストール" Click="OnInstallClick" Margin="0,0,8,8"/>
            <Button x:Name="RestartButton" Style="{StaticResource AccentButton}" Content="アプリを起動し直す" Click="OnRestartClick" Margin="0,0,8,8" Visibility="Collapsed"
                    ToolTip="アプリを終了して、すぐに起動し直します（その間の数秒は、ファンは BIOS の自動制御になります）"/>
            <Button x:Name="SiteButton" Style="{StaticResource GhostButton}" Content="公式サイトを開く（pawnio.eu）" Click="OnSiteClick" Margin="0,0,8,8"
                    ToolTip="winget が使えないときは、公式サイトからインストーラーを入手して実行してください"/>
            <Button x:Name="RecheckButton" Style="{StaticResource GhostButton}" Content="確かめ直す" Click="OnRecheckClick" Margin="0,0,8,8"
                    ToolTip="ほかの方法（公式サイトのインストーラーなど）で入れたあとに押してください"/>
        </WrapPanel>
        <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
